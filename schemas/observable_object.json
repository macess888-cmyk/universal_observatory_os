{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObservableObject",
  "description": "Universal parent object for every entity within the Universal Observatory Operating System.",

  "type": "object",

  "required": [
    "id",
    "name",
    "category",
    "status"
  ],

  "properties": {

    "id": {
      "type": "string",
      "description": "Globally unique identifier."
    },

    "name": {
      "type": "string"
    },

    "category": {
      "type": "string"
    },

    "description": {
      "type": "string"
    },

    "domain": {
      "type": "string"
    },

    "subcategory": {
      "type": "string"
    },

    "status": {
      "type": "string"
    },

    "scale": {
      "type": "string"
    },

    "location": {
      "type": "string"
    },

    "created_at": {
      "type": "string"
    },

    "updated_at": {
      "type": "string"
    },

    "version": {
      "type": "string"
    },

    "owner": {
      "type": "string"
    },

    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "relationships": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "measurements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "recoveries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "boundaries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "confidence": {
      "type": "number"
    },

    "uncertainty": {
      "type": "number"
    },

    "provenance": {
      "type": "string"
    },

    "history": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "notes": {
      "type": "string"
    }

  }
}